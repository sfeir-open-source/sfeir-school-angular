{
  "name": "22-structural-directive",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sfeir",
  "sourceRoot": "apps/22-structural-directive/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/22-structural-directive",
        "browser": "apps/22-structural-directive/src/main.ts",
        "tsConfig": "apps/22-structural-directive/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/22-structural-directive/public",
            "output": "public"
          }
        ],
        "styles": ["./node_modules/@angular/material/prebuilt-themes/indigo-pink.css", "apps/22-structural-directive/src/styles.scss"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "fileReplacements": [
            {
              "replace": "apps/22-structural-directive/src/environments/environment.ts",
              "with": "apps/22-structural-directive/src/environments/environment.development.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "dependsOn": [
        {
          "projects": "server-rest",
          "target": "serve"
        }
      ],
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "22-structural-directive:build:production"
        },
        "development": {
          "buildTarget": "22-structural-directive:build:development"
        }
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "22-structural-directive:build",
        "staticFilePath": "dist/apps/22-structural-directive/browser",
        "spa": true
      }
    }
  }
}
