{
  "cli": {
    "packageManager": "npm"
  },
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": ["build", "lint", "test", "e2e"]
      }
    }
  },
  "generators": {
    "@nx/angular:application": {
      "e2eTestRunner": "none",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest"
    },
    "@nx/angular:component": {
      "style": "scss",
      "type": "component"
    },
    "@schematics/angular:component": {
      "type": "component"
    },
    "@nx/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@nx/angular:service": {
      "type": "service"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@nx/angular:scam": {
      "type": "component"
    },
    "@nx/angular:scam-directive": {
      "type": "directive"
    },
    "@nx/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@nx/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@nx/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@nx/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@nx/angular:resolver": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "defaultProject": "01-hands-on",
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "cache": true
    },
    "@nx/eslint:lint": {
      "inputs": ["default", "^default", "{workspaceRoot}/eslint.config.mjs", "{workspaceRoot}/tools/eslint-rules/**/*"],
      "cache": true
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        {
          "json": "{workspaceRoot}/tsconfig.json",
          "fields": ["extends", "files", "include"]
        }
      ]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/angular:ng-packagr-lite": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [],
    "production": [
      "default",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/eslint.config.mjs"
    ]
  },
  "useInferencePlugins": false,
  "defaultBase": "main",
  "analytics": true,
  "plugins": [
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "watch"
      },
      "include": [
        "libs/ui/**/*",
        "libs/ui-solution/**/*",
        "apps/01-hands-on/**/*",
        "apps/01-hands-on-solution/**/*",
        "apps/02-component-tree/**/*",
        "apps/02-component-tree-solution/**/*",
        "apps/03-bindings/**/*",
        "apps/03-bindings-solution/**/*",
        "apps/04-events/**/*",
        "apps/04-events-solution/**/*",
        "apps/05-input-output/**/*",
        "apps/05-input-output-solution/**/*",
        "apps/06-pipe/**/*",
        "apps/06-pipe-solution/**/*",
        "apps/07-provider/**/*",
        "apps/07-provider-solution/**/*",
        "apps/08-directive/**/*",
        "apps/08-directive-solution/**/*",
        "apps/09-router/**/*",
        "apps/09-router-solution/**/*",
        "apps/10-control-flow/**/*",
        "apps/10-control-flow-solution/**/*",
        "apps/11-http/**/*",
        "apps/11-http-solution/**/*",
        "apps/12-template-form/**/*",
        "apps/12-template-form-solution/**/*",
        "apps/13-reactive-form/**/*",
        "apps/13-reactive-form-solution/**/*",
        "apps/14-signal-form/**/*",
        "apps/14-signal-form-solution/**/*",
        "apps/15-reactive-thinking/**/*",
        "apps/15-reactive-thinking-solution/**/*",
        "apps/16-advanced-routing/**/*",
        "apps/16-advanced-routing-solution/**/*",
        "apps/17-guards/**/*",
        "apps/17-guards-solution/**/*",
        "apps/18-resolver/**/*",
        "apps/18-resolver-solution/**/*",
        "apps/19-interceptors/**/*",
        "apps/19-interceptors-solution/**/*",
        "apps/20-ng-content/**/*",
        "apps/20-ng-content-solution/**/*",
        "apps/21-teleportation/**/*",
        "apps/21-teleportation-solution/**/*",
        "apps/22-structural-directive/**/*",
        "apps/22-structural-directive-solution/**/*"
      ]
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      },
      "include": [
        "apps/server/**/*",
        "libs/types/**/*",
        "libs/ui/**/*",
        "libs/ui-solution/**/*",
        "apps/01-hands-on/**/*",
        "apps/01-hands-on-solution/**/*",
        "apps/02-component-tree/**/*",
        "apps/02-component-tree-solution/**/*",
        "apps/03-bindings/**/*",
        "apps/03-bindings-solution/**/*",
        "apps/04-events/**/*",
        "apps/04-events-solution/**/*",
        "apps/05-input-output/**/*",
        "apps/05-input-output-solution/**/*",
        "apps/06-pipe/**/*",
        "apps/06-pipe-solution/**/*",
        "apps/07-provider/**/*",
        "apps/07-provider-solution/**/*",
        "apps/08-directive/**/*",
        "apps/08-directive-solution/**/*",
        "apps/09-router/**/*",
        "apps/09-router-solution/**/*",
        "apps/10-control-flow/**/*",
        "apps/10-control-flow-solution/**/*",
        "apps/11-http/**/*",
        "apps/11-http-solution/**/*",
        "apps/12-template-form/**/*",
        "apps/12-template-form-solution/**/*",
        "apps/13-reactive-form/**/*",
        "apps/13-reactive-form-solution/**/*",
        "apps/14-signal-form/**/*",
        "apps/14-signal-form-solution/**/*",
        "apps/15-reactive-thinking/**/*",
        "apps/15-reactive-thinking-solution/**/*",
        "apps/16-advanced-routing/**/*",
        "apps/16-advanced-routing-solution/**/*",
        "apps/17-guards/**/*",
        "apps/17-guards-solution/**/*",
        "apps/18-resolver/**/*",
        "apps/18-resolver-solution/**/*",
        "apps/19-interceptors/**/*",
        "apps/19-interceptors-solution/**/*",
        "apps/20-ng-content/**/*",
        "apps/20-ng-content-solution/**/*",
        "apps/21-teleportation/**/*",
        "apps/21-teleportation-solution/**/*",
        "apps/22-structural-directive/**/*",
        "apps/22-structural-directive-solution/**/*"
      ]
    }
  ]
}
